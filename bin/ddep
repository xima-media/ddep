          "thumb",
          "thumb_*"
        ],
        "exclude_extensions": [
          "mp4",
          "zip",
          "pdf",
          "exe",
          "doc",
          "docx",
          "pptx",
          "ppt",
          "xls",
          "xlsx",
          "xlsm",
          "tiff",
          "tif",
          "potx",
          "mpg",
          "mp3",
          "avi",
          "wmv",
          "flv",
          "eps",
          "ai",
          "mov"
        ]
      }
    }
  }
}
JSON
}

# Evaluates a yq expression against HOSTS_FILE's content - preferring a
# host-installed mikefarah/yq (verified via --version, not just "on PATH" -
# "yq" is not one tool, see YQ_IMAGE) if there is one, else a pinned throwaway
# container. Needed because docker-compose-deploy's ci/reset.yml runs ddep
# from a plain docker:*-cli image with no local daemon - its `docker` CLI
# only ever reaches the remote deploy host over SSH, so that job's setup
# installs a real yq binary instead, which this then prefers. A developer's
# machine already has docker (required below for the remote host itself) and
# can run the container fallback directly.
#
# Piped in over stdin ("-") rather than a bind mount for the container path -
# avoids host/container path translation issues on Docker Desktop for Mac.
#
# -o=json -r: needed together - "-o=json" alone still wraps a map result in
# YAML syntax, "-r" alone still emits YAML for a map result; combined, they
# give plain JSON for maps and an unquoted raw string for scalars.
#
# DOCKER_HOST='' overrides whatever the caller's environment has it set to -
# ci/reset.yml exports DOCKER_HOST="ssh://<remote deploy host>" before most
# ddep invocations, which would otherwise make an unprefixed `docker run`
# here try to run on the remote host instead of locally.
run_yq() {
    if command -v yq >/dev/null 2>&1 && yq --version 2>&1 | grep -q mikefarah; then
        yq eval -o=json -r "$1" - < "${HOSTS_FILE}"
        return
    fi

    DOCKER_HOST='' docker run --rm -i "${YQ_IMAGE}" eval -o=json -r "$1" - < "${HOSTS_FILE}"
}

# Derives {"app": ..., "hosts": {...}, "compose_projects_root": ...} from
# .docker/hosts.yaml - the exclusive source for all three (see HOSTS_FILE's
# comment); "{}" if the file doesn't exist, though load_config never lets a
# real run get this far without it. compose_projects_root has no built-in
# default - validate_config requires it, same as app/hosts.
#
# run_yq is called exactly once here (just to convert the whole file to
# JSON), not once per field - the yq Docker fallback pays a real per-`docker
# run` container-startup cost regardless of whether the image is already
# cached (confirmed empirically - it's generic container lifecycle overhead,
# not image-pull time). Everything past that single conversion is jq against
# the resulting JSON, already a required, always-local dependency.
load_hosts_config() {
    if [[ ! -f "${HOSTS_FILE}" ]]; then
        echo '{}'
        return
    fi

    run_yq '.' | jq '
        .all as $all
        | ($all.vars.app_name // "") as $app
        # Same directory ansible/deploy.yml derives remote_project_dir from.
        | ($all.vars.compose_projects_root // "") as $compose_projects_root
        | (reduce ["dev", "test", "live"][] as $group
            ({};
              ($all.children[$group].hosts // {}) as $group_hosts
              # Every host in this group, addressable by its own hosts.yaml key.
              | . + ($group_hosts | with_entries(.value = "\(.value.ansible_user)@\(.value.ansible_host)"))
              | ($group_hosts | to_entries | .[0].value // {}) as $first
              # Tier-level convenience default (host positional arg = dev/test/
              # live) - the first host in file order. Not reliable for
              # targeting one specific host once a group has more than one -
              # address it by its own key instead (above).
              | if ($first.ansible_user != null and $first.ansible_host != null)
                then . + {($group): "\($first.ansible_user)@\($first.ansible_host)"}
                else .
                end
            )
          ) as $hosts
        | (if $app != "" then {app: $app} else {} end)
          + (if $compose_projects_root != "" then {compose_projects_root: $compose_projects_root} else {} end)
          + (if ($hosts | length) > 0 then {hosts: $hosts} else {} end)
    '
}

load_config() {
    local local_config="${LOCAL_CONFIG_FILE}"
    local local_json="{}"

    CONFIG_FILE=$(mktemp)

    if [[ ! -f "${HOSTS_FILE}" ]]; then
        echo "${COLOR_RED}Error: ${HOSTS_FILE} missing${COLOR_RESET}" >&2
        exit 1
    fi

    if [[ -f "${local_config}" ]]; then
        local_json="$(cat "${local_config}")"

        # Pre-hosts.yaml ddep.json schema - ignored now, never a fallback.
        # app/hosts/compose_projects_root are exclusively load_hosts_config's
        # concern (see below) - ddep.json never contributes to them at all.
        if jq -e '(.app != null) or (.hosts != null) or (.compose_projects_root != null)' <<< "${local_json}" >/dev/null; then
            echo "${COLOR_YELLOW}Warning: ${local_config} sets \"app\"/\"hosts\"/\"compose_projects_root\" - all" >&2
            echo "         ignored. These are required in ${HOSTS_FILE} instead - remove them" >&2
            echo "         from ${local_config}.${COLOR_RESET}" >&2
            local_json="$(jq 'del(.app, .hosts, .compose_projects_root)' <<< "${local_json}")"
        fi
    fi

    # load_hosts_config's app/hosts/compose_projects_root and this
    # default+local settings merge are two separate concerns, only ever tied
    # together by the app name - so $hosts_config is overlaid flat (+), not
    # deep-merged: none of its keys ever exist in $default or $local (the
    # latter guaranteed by the strip above) for a recursive merge to matter.
    jq -n \
        --slurpfile default <(load_default_config) \
        --argjson hosts_config "$(load_hosts_config)" \
        --argjson local "${local_json}" \
        '
        def deepmerge(a;b):
            reduce (b | keys[]) as $key (
                a;
                if (.[$key] | type) == "object"
                   and (b[$key] | type) == "object"
                then
                    .[$key] = deepmerge(.[$key]; b[$key])
                else
                    .[$key] = b[$key]
                end
            );

        deepmerge($default[0]; $local) + $hosts_config
        ' > "${CONFIG_FILE}"
}

validate_config() {
    local missing=()

    if [[ "$(jq -r '.app // empty' "${CONFIG_FILE}")" == "" ]]; then
        missing+=("app")
    fi

    if [[ "$(jq -r '.hosts // empty' "${CONFIG_FILE}")" == "" ]]; then
        missing+=("hosts")
    fi

    if [[ "$(jq -r '.compose_projects_root // empty' "${CONFIG_FILE}")" == "" ]]; then
        missing+=("compose_projects_root")
    fi

    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "${COLOR_RED}Error: missing required configuration: ${missing[*]}${COLOR_RESET}" >&2
        exit 1
    fi
}

parse_config_json() {
    # validate_config already guarantees .app is present and non-empty
    APP_NAME=$(jq -r '.app' "${CONFIG_FILE}")

    APP_CONFIG=".settings[\"${APP_NAME}\"]"
    if [[ "$(jq -r "${APP_CONFIG} // empty" "${CONFIG_FILE}")" == "" ]]; then
        echo "${COLOR_RED}Error: app '${APP_NAME}' is not defined in default configuration${COLOR_RESET}" >&2
        exit 1
    fi

    # Already guaranteed non-empty by validate_config, called before this.
    COMPOSE_PROJECTS_ROOT=$(jq -r '.compose_projects_root' "${CONFIG_FILE}")
    COMPOSE_PROJECTS_ROOT="${COMPOSE_PROJECTS_ROOT%/}"

    MARIADB_VERSION=$(jq -r '.mariadb_version // "lts"' "${CONFIG_FILE}")

    REMOTE_DOCKER_HOST=$(jq -r ".hosts.${host} // empty" "${CONFIG_FILE}")

    if [[ -z "${REMOTE_DOCKER_HOST}" ]]; then
        host="$(select_host)"
        REMOTE_DOCKER_HOST=$(jq -r ".hosts.${host} // empty" "${CONFIG_FILE}")
    fi

    # Database configuration
    DB_MIGRATION=$(jq -r "${APP_CONFIG}.db.migration" "${CONFIG_FILE}")

    # Rsync configuration
    RSYNC_MAX_SIZE_MB=$(jq -r "${APP_CONFIG}.rsync.max_size_mb" "${CONFIG_FILE}")

    RSYNC_REMOTE_PATH=$(jq -r "${APP_CONFIG}.rsync.remote_path" "${CONFIG_FILE}")
    RSYNC_REMOTE_PATH="${RSYNC_REMOTE_PATH%/}"

    mapfile -t RSYNC_DIRECTORIES < <(
        jq -r "${APP_CONFIG}.rsync.directories[]" "${CONFIG_FILE}"
    )

    mapfile -t RSYNC_EXCLUDE_PATHS < <(
        jq -r "${APP_CONFIG}.rsync.exclude_paths[]" "${CONFIG_FILE}"
    )

    mapfile -t RSYNC_EXCLUDE_EXTENSIONS < <(
        jq -r "${APP_CONFIG}.rsync.exclude_extensions[]" "${CONFIG_FILE}"
    )


    # Database table exclusions: exclude_rows keeps schema, skips rows only;
    # exclude_tables drops the table/view entirely. Both are only ever read via
    # resolve_ignore_table_args's nameref (passed by name, not $expansion) -
    # static analysis can't trace that across the function boundary.
    # shellcheck disable=SC2034
    mapfile -t DB_EXCLUDE_ROWS < <(
        jq -r "(${APP_CONFIG}.db.exclude_rows // []) | .[]" "${CONFIG_FILE}"
    )
    # shellcheck disable=SC2034
    mapfile -t DB_EXCLUDE_TABLES < <(
        jq -r "(${APP_CONFIG}.db.exclude_tables // []) | .[]" "${CONFIG_FILE}"
    )
}

get_env_value() {
    awk -F= -v key="$1" '$1 == key {print $2}'
}


get_mariadb_credentials() {
    local -n _mariadb_host=$1
    local -n _mariadb_name=$2
    local -n _mariadb_user=$3
    local -n _mariadb_password=$4
    local -n _mariadb_port=$5
    local -n _mariadb_ssl=$6

    local environment_file_path="${COMPOSE_PROJECTS_ROOT}/${git_project_name}_${target_env}/.app.env.provision"

    if ! ssh "${REMOTE_DOCKER_HOST}" "test -f '${environment_file_path}'"; then
        echo "${COLOR_RED}Error: ${environment_file_path} missing${COLOR_RESET}" >&2
        exit 1
    fi

    # The env file holds the database password and every other application secret,
    # so keep the whole read/parse out of the --debug trace: set -x would echo
    # both the full file contents and the parsed password. env_content is scoped
    # to this function so those secrets do not linger in a global afterwards.
    { set +x; } 2>/dev/null

    local env_content
    env_content=$(ssh "${REMOTE_DOCKER_HOST}" "cat '${environment_file_path}'")

    _mariadb_host=$(get_env_value "MARIADB_HOST" <<< "${env_content}")
    _mariadb_name=$(get_env_value "MARIADB_DBNAME" <<< "${env_content}")
    _mariadb_user=$(get_env_value "MARIADB_USER" <<< "${env_content}")
    _mariadb_password=$(get_env_value "MARIADB_PASSWORD" <<< "${env_content}")
    _mariadb_port=$(get_env_value "MARIADB_PORT" <<< "${env_content}")
    _mariadb_ssl=$(get_env_value "MARIADB_SSL" <<< "${env_content}")

    _mariadb_port=${_mariadb_port:-3306}
    _mariadb_ssl=${_mariadb_ssl:-false}

    if [[ "${DEBUG}" == "true" ]]; then
        set -x
    fi
}

# Populates the nameref array with ["--skip-ssl"] unless MARIADB_SSL=true,
# else leaves it empty - an array, not a string, so it splices cleanly via
# "${_ssl_args[@]}" into a "$@"-forwarded list (an empty array contributes
# nothing, unlike an empty-string variable, which would land as a stray blank
# positional and shift every argument after it).
#
# mariadb/mariadb-dump already attempt SSL by default (with certificate
# verification silently disabled for a passwordless connection - the "option
# --ssl-verify-server-cert is disabled" warning seen throughout this
# project's dumps/imports), so MARIADB_SSL=true here just leaves that default
# alone. Real verification would additionally need --ssl-ca, not supported
# yet.
mariadb_ssl_args() {
    local -n _ssl_args=$1
    if [[ "$2" != "true" ]]; then
        _ssl_args=("--skip-ssl")
    else
        _ssl_args=()
    fi
}

# Plain ssh call before DOCKER_HOST=ssh://... is exported, so a new host's
# key-trust prompt (ssh's own default "ask" behavior - left untouched) is
# guaranteed to actually show, rather than possibly swallowed by docker's own
# ssh transport. A changed key still fails outright, no prompt - confirmed
# against a real SSH server for both cases. PasswordAuthentication/
# KbdInteractiveAuthentication=no only skips a *password* prompt (passwordless
# key auth is already assumed - see the header comment); the host-key prompt
# is unaffected.
#
# -n is required: this probe otherwise inherits ddep's own stdin - for db:import,
# that's the piped SQL dump. ssh reads/forwards stdin to set up the session even
# for a trivial remote command like `true`, so without -n it silently consumes
# however many bytes it buffers off the front of the dump before the connection
# tears down (non-deterministic - depends on ssh's own timing), leaving
# db:import's own `cat > tmpfile` (which runs much later) with a truncated,
# mid-stream start. Confirmed as the actual cause of intermittent db:import
# corruption that no amount of gzip/charset/binary-mode/FK-checks tuning fixed,
# since none of those ever touched the real problem: data already missing
# before db:import's own stdin read even began.
ensure_ssh_host_trusted() {
    if ! ssh -n -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no "${REMOTE_DOCKER_HOST}" true; then
        echo "${COLOR_RED}Error: could not establish an SSH connection to '${REMOTE_DOCKER_HOST}' (host '${host}') - see ssh's own error above. A host key verification failure specifically (not a connection/auth failure) means the key on record for this host has changed - confirm with whoever manages it before proceeding, rather than removing the stale known_hosts entry yourself.${COLOR_RESET}" >&2
        exit 1
    fi
}

ensure_mariadb_image() {
    local image="mariadb:${MARIADB_VERSION}"
    local output
    if ! output="$(docker pull "${image}" 2>&1)"; then
        # A pull can fail transiently or offline; only fatal if the image is not
        # already available on the (remote) daemon.
        if ! docker image inspect "${image}" >/dev/null 2>&1; then
            echo "${COLOR_RED}Error: could not pull ${image} and it is not available:${COLOR_RESET}" >&2
            echo "${output}" >&2
            exit 1
        fi
        echo "${COLOR_YELLOW}Warning: could not refresh ${image}; using the existing image.${COLOR_RESET}" >&2
    fi
}

rsync_exclude_params() {
    rsync_exclude_params=()

    for _exclude_path in "${RSYNC_EXCLUDE_PATHS[@]}"; do
        rsync_exclude_params+=("--exclude=**/${_exclude_path}")
    done

    for _exclude_extension in "${RSYNC_EXCLUDE_EXTENSIONS[@]}"; do
        rsync_exclude_params+=("--exclude=*.${_exclude_extension,,}")
        rsync_exclude_params+=("--exclude=*.${_exclude_extension^^}")
    done
}

get_container_id() {
    # Returns 0 and sets the nameref when exactly one container matches.
    # Returns 1 (no match) or 2 (more than one match) and prints a specific
    # message to stderr, so callers can tell the two failure modes apart instead
    # of reporting every failure as "not found".
    local -n _container_id=$1
    local environment_path="${COMPOSE_PROJECTS_ROOT}/${git_project_name}_${target_env}"
    local ids
    ids=$(docker ps -q \
        --filter "label=com.docker.compose.project.working_dir=${environment_path}" \
        --filter "label=com.docker.compose.service=${APP_NAME}")

    if [ -z "$ids" ]; then
        echo "${COLOR_RED}Error: no container found for project '${git_project_name}', environment '${target_env}', service '${APP_NAME}'.${COLOR_RESET}" >&2
        return 1
    fi

    if [ "$(printf '%s\n' "$ids" | wc -l)" -gt 1 ]; then
        echo "${COLOR_RED}Error: multiple containers matched project '${git_project_name}', environment '${target_env}', service '${APP_NAME}':${COLOR_RESET}" >&2
        printf '%s\n' "$ids" | sed 's/^/  /' >&2
        return 2
    fi

    _container_id=$ids
    return 0
}

get_available_remote_envs() {
    docker ps -a \
        --filter "label=com.docker.compose.service=${APP_NAME}" \
        --format '{{.Label "com.docker.compose.project.working_dir"}}' \
    | grep "/${git_project_name}_" \
    | sed "s|.*/${git_project_name}_||" \
    | sort -u
}

# $1 (optional): an environment that didn't match, for a "not found" prompt.
select_env() {
    local invalid_env="${1:-}"
    local envs=()

    mapfile -t envs < <(get_available_remote_envs)

    if [[ "${#envs[@]}" -eq 0 ]]; then
        echo "${COLOR_RED}Error: no remote environments found on host ${host}${COLOR_RESET}" >&2
        exit 1
    fi

    # The picker reads from the controlling terminal (not stdin, which may be a
    # pipe, e.g. db:import). Without a terminal (CI), environment must be given
    # explicitly.
    if [[ ! -r /dev/tty ]]; then
        if [[ -n "${invalid_env}" ]]; then
            echo "${COLOR_RED}Error: environment '${invalid_env}' not found on host '${host}', and no terminal available to choose one." >&2
        else
            echo "${COLOR_RED}Error: no environment given and no terminal available to choose one." >&2
        fi
        echo "       Pass it explicitly: ddep ${command} ${host} <environment>.${COLOR_RESET}" >&2
        exit 1
    fi

    if [[ -n "${invalid_env}" ]]; then
        echo "Environment '${invalid_env}' not found on host '${host}' - did you mean one of these?" >&2
    else
        echo "Select environment on ${host}:" >&2
    fi

    PS3="Environment: "
    select env in "${envs[@]}"; do
        if [[ -n "${env}" ]]; then
            printf '%s\n' "${env}"
            return
        fi

        echo "${COLOR_RED}Invalid selection${COLOR_RESET}" >&2
    done < /dev/tty
}

# Same "not found, did you mean?" pattern as select_env, but for the host.
select_host() {
    local hosts=()
    mapfile -t hosts < <(jq -r '.hosts | keys[]' "${CONFIG_FILE}")

    if [[ "${#hosts[@]}" -eq 0 ]]; then
        echo "${COLOR_RED}Error: host '${host}' is not configured, and .docker/hosts.yaml declares no hosts at all.${COLOR_RESET}" >&2
        exit 1
    fi

    if [[ ! -r /dev/tty ]]; then
        echo "${COLOR_RED}Error: host '${host}' is not configured, and no terminal available to choose one." >&2
        echo "       Configured hosts: ${hosts[*]}${COLOR_RESET}" >&2
        exit 1
    fi

    echo "Host '${host}' not found - did you mean one of these?" >&2

    PS3="Host: "
    select h in "${hosts[@]}"; do
        if [[ -n "${h}" ]]; then
            printf '%s\n' "${h}"
            return
        fi

        echo "${COLOR_RED}Invalid selection${COLOR_RESET}" >&2
    done < /dev/tty
}

confirm_destructive() {
    # $1 = human-readable description of the destructive action.
    # Confirmation is read from the controlling terminal (/dev/tty), not stdin,
    # because db:import consumes stdin. Non-dev hosts require typing the host slug
    # for extra safety; non-interactive runs (CI, no TTY) must pass --force.
    local action="$1"
    local expected="yes"
    local answer=""

    if [[ "${FORCE}" == "true" ]]; then
        return 0
    fi

    if [[ "${host}" != "dev" ]]; then
        expected="${host}"
    fi

    if [[ ! -r /dev/tty ]]; then
        echo "${COLOR_RED}Error: refusing to ${action}" >&2
        echo "       on host '${host}' (${target_env}) without confirmation." >&2
        echo "       No terminal available; re-run with --force to proceed.${COLOR_RESET}" >&2
        exit 1
    fi

    echo "${COLOR_YELLOW}WARNING: about to ${action}" >&2
    echo "         host '${host}' (${REMOTE_DOCKER_HOST}), environment '${target_env}'.${COLOR_RESET}" >&2
    printf "Type '%s' to continue: " "${expected}" >&2
    read -r answer < /dev/tty

    if [[ "${answer}" != "${expected}" ]]; then
        echo "${COLOR_RED}Aborted.${COLOR_RESET}" >&2
        exit 1
    fi
}

# Resolves a set of exclude_rows/exclude_tables regex patterns (JSON array,
# already loaded into a bash array by the caller) against the remote database's
# actual table/view names, appending "--ignore-table=db.name" for each match
# into the nameref array. Separate from db:export's structure/data dump calls so
# exclude_rows and exclude_tables can each be resolved to their own args and
# applied to different halves of the dump.
resolve_ignore_table_args() {
    local -n _patterns=$1
    local -n _ignore_args=$2
    local db_host="$3" db_port="$4" db_user="$5" db_password="$6" db_name="$7" db_ssl="$8"

    if [ "${#_patterns[@]}" -eq 0 ]; then
        return 0
    fi

    # Convert JSON regex array into MariaDB REGEXP expression
    local regex
    regex=$(IFS="|"; echo "${_patterns[*]}")

    local -a ssl_args
    mariadb_ssl_args ssl_args "${db_ssl}"

    # MYSQL_PWD is exported with tracing disabled so --debug never echoes it,
    # and forwarded via -e (not -p) so it never appears in argv either.
    local tables
    tables=$(
        { set +x; } 2>/dev/null
        export MYSQL_PWD="${db_password}"
        docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
        sh -c "mariadb \
            --host '${db_host}' \
            --port '${db_port}' \
            --user '${db_user}' \
            ${ssl_args[*]-} \
            -N -e \"
            SELECT TABLE_NAME
            FROM information_schema.tables
            WHERE table_schema='${db_name}'
            AND TABLE_NAME REGEXP '${regex}';
            \"")

    local table
    for table in ${tables}; do
        _ignore_args+=( "--ignore-table=${db_name}.${table}" )
    done
}

# Allow sourcing (e.g. from tests) to load the functions above without running
# the CLI below.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    return 0
fi

# Main script execution
command=""
host=""
target_env=""
exec_command=""
tmpfile=""
FORCE=false

# Populated via namerefs by get_container_id and get_mariadb_credentials.
container_id=""
db_host=""
db_name=""
db_user=""
db_password=""
db_port=""

cleanup() {
    # Preserve the triggering exit status: under set -e, a failing last command
    # in an EXIT trap would otherwise become the script's exit code.
    local exit_code=$?
    [[ -n "${CONFIG_FILE:-}" ]] && rm -f "${CONFIG_FILE}"
    [[ -n "${tmpfile:-}" ]] && rm -f "${tmpfile}"
    exit "${exit_code}"
}
trap cleanup EXIT

# Flags always precede the command - the loop stops as soon as one is matched
# (condition below, not a per-case check), so a flag typo'd or placed after the
# command is never silently absorbed as part of it, and any leftover token that
# looks like a flag (see below) is rejected the same way instead of being
# misread as a host/environment/command value.
while [[ $# -gt 0 && -z "${command}" ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            echo "ddep ${DDEP_VERSION}"
            exit 0
            ;;
        --debug)
            DEBUG=true
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        media:push|media:pull|db:import|db:export|db:push|db:pull|logs|config|info|ssh|exec)
            command="$1"
            shift
            ;;
        *)
            echo "${COLOR_RED}Unknown argument: $1${COLOR_RESET}" >&2
            exit 1
            ;;
    esac
done
if [ -z "${command}" ]; then
    echo "No command provided. Use one of: media:push, media:pull, ssh, exec, db:import, db:export, db:push, db:pull, logs, config, info" >&2
    exit 1
fi

for _remaining_arg in "$@"; do
    if [[ "${_remaining_arg}" == -* ]]; then
        echo "${COLOR_RED}Error: unexpected argument(s) after '${command}': $* - flags must come before the command.${COLOR_RESET}" >&2
        exit 1
    fi
done
unset _remaining_arg

# host/environment are positional, after the command. Both stay optional -
# host defaults to "dev" below, environment falls back to the interactive
# picker (select_env) further down if still empty.
#
# "config" takes neither (never touches a remote host). "exec" requires all
# three (host, environment, command) since its third positional slot would
# otherwise be ambiguous with an optional host/environment (is "ddep exec ls"
# host=ls, or command=ls with default host/environment?) - "ssh" opens an
# interactive shell only, never a command, which is exactly why the two are
# split into separate commands.
case "${command}" in
    config)
        if [[ $# -gt 0 ]]; then
            echo "${COLOR_RED}Error: unexpected argument(s) after 'config': $* - config takes no arguments.${COLOR_RESET}" >&2
            exit 1
        fi
        ;;
    exec)
        if [[ $# -ne 3 ]]; then
            echo "${COLOR_RED}Error: exec requires exactly <host> <environment> <command> (quote the command as one argument if it contains spaces).${COLOR_RESET}" >&2
            exit 1
        fi
        host="$1"
        target_env="$2"
        exec_command="$3"
        ;;
    *)
        if [[ $# -gt 2 ]]; then
            echo "${COLOR_RED}Error: unexpected argument(s) after '${command}': $* - expected at most <host> <environment>.${COLOR_RESET}" >&2
            exit 1
        fi
        [[ $# -ge 1 ]] && host="$1"
        [[ $# -ge 2 ]] && target_env="$2"
        ;;
esac

check_requirements

if [[ "${DEBUG}" == "true" ]]; then
    set -x
fi

# Set defaults if not provided
if [ -z "${host}" ]; then
    host="dev"
fi

# config only inspects .docker/hosts.yaml/.docker/ddep.json merged with the
# built-in defaults; it does not touch git or any remote host. Intentionally
# skips validate_config so a broken local config can still be inspected.
if [ "${command}" = "config" ]; then
    load_config
    jq '.' "${CONFIG_FILE}"
    exit 0
fi

# Needed before Docker environment lookup; the project name comes from the origin
# remote, so ddep must run inside a git working copy that has one.
if ! origin_url="$(git remote get-url origin 2>/dev/null)"; then
    echo "${COLOR_RED}Error: could not determine the project name." >&2
    echo "       ddep must be run from inside a git working copy with an 'origin' remote.${COLOR_RESET}" >&2
    exit 1
fi
git_project_name="$(basename "${origin_url}")"
git_project_name="${git_project_name%.git}"

load_config
validate_config
parse_config_json

ensure_ssh_host_trusted
export DOCKER_HOST="ssh://${REMOTE_DOCKER_HOST}"

if [[ -z "${target_env:-}" ]]; then
    target_env="$(select_env)"
elif ! get_available_remote_envs | grep -qxF "${target_env}"; then
    target_env="$(select_env "${target_env}")"
fi

# stderr, never stdout (e.g. db:export's dump stream). Suppressed for
# db:pull/db:push's own child invocation.
if [[ "${DDEP_CHILD_INVOCATION:-}" != "true" ]]; then
    echo "${COLOR_CYAN}Using host '${host}', environment '${target_env}'.${COLOR_RESET}" >&2
fi

# Run commands
if [ "${command}" = "media:push" ]; then
    confirm_destructive "overwrite media files in the remote container"
    rsync_exclude_params
    if ! get_container_id container_id; then
        exit 1
    fi

    for dir in "${RSYNC_DIRECTORIES[@]}"; do
        if [[ ! -d "$(pwd)/public/${dir}" ]]; then
            echo "Directory public/${dir} does not exist, skipping..."
            continue
        fi
        rsync -e 'docker exec -i' -avz "--max-size=${RSYNC_MAX_SIZE_MB}m" "${rsync_exclude_params[@]}" "$(pwd)/public/${dir}" "${container_id}:${RSYNC_REMOTE_PATH}/"
    done

elif [ "${command}" = "media:pull" ]; then
    rsync_exclude_params
    if ! get_container_id container_id; then
        exit 1
    fi

    for dir in "${RSYNC_DIRECTORIES[@]}"; do
        if ! docker exec "${container_id}" [ -d "${RSYNC_REMOTE_PATH}/${dir}" ]; then
            echo "Directory ${RSYNC_REMOTE_PATH}/${dir} does not exist in container, skipping..."
            continue
        fi
        # ensure local target directory exists
        mkdir -p "$(pwd)/public/${dir}"
        rsync -e 'docker exec -i' -avz "--max-size=${RSYNC_MAX_SIZE_MB}m" "${rsync_exclude_params[@]}" "${container_id}:${RSYNC_REMOTE_PATH}/${dir}" "$(pwd)/public/"
    done

elif [ "${command}" = "ssh" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    # Only allocate a TTY (-t) when running interactively; in CI/pipes -t fails
    # with "the input device is not a TTY".
    exec_flags="-i"
    if [ -t 0 ] && [ -t 1 ]; then
        exec_flags="-it"
    fi
    docker exec "${exec_flags}" "${container_id}" /bin/bash

elif [ "${command}" = "exec" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    # Only allocate a TTY (-t) when running interactively; in CI/pipes -t fails
    # with "the input device is not a TTY".
    exec_flags="-i"
    if [ -t 0 ] && [ -t 1 ]; then
        exec_flags="-it"
    fi
    docker exec "${exec_flags}" "${container_id}" /bin/bash -c "${exec_command}"

elif [ "${command}" = "logs" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    docker logs -f "${container_id}"

elif [ "${command}" = "info" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    jq -n --arg container_id "${container_id}" '{container_id: $container_id}'

elif [ "${command}" = "db:import" ]; then
    if [ -t 0 ]; then
        echo "${COLOR_RED}Error: db:import reads the SQL dump (plain or gzip) from stdin; pipe one in, e.g.:" >&2
        echo "       ddep db:import dev < dump.sql.gz${COLOR_RESET}" >&2
        exit 1
    fi

    # Buffer stdin to a file; cleanup runs via the global EXIT trap.
    tmpfile=$(mktemp)
    cat > "${tmpfile}"

    # ddep db:export emits a gzip stream (its two dumps concatenated as a
    # multi-member gzip stream); detect that by magic byte so a plain-SQL dump
    # piped in some other way (e.g. a raw mariadb-dump/TYPO3 export) still works,
    # by compressing it here instead. Either way, the file that crosses the
    # SSH-tunnelled Docker connection below is compressed, not plain SQL.
    if [ "$(head -c2 "${tmpfile}" | od -An -tx1 | tr -d ' \n')" != "1f8b" ]; then
        gzip -c "${tmpfile}" > "${tmpfile}.gz"
        mv "${tmpfile}.gz" "${tmpfile}"
    fi

    # gzip always writes a header, so empty stdin yields a valid-but-empty archive;
    # verify the decompressed stream actually contains data before proceeding.
    if [ -z "$(gunzip -c "${tmpfile}" | head -c1)" ]; then
        echo "${COLOR_RED}Error: no data received on stdin; aborting db:import.${COLOR_RESET}" >&2
        exit 1
    fi

    confirm_destructive "overwrite the remote database and run migrations"

    get_mariadb_credentials db_host db_name db_user db_password db_port db_ssl
    ensure_mariadb_image
    ssl_args=()
    mariadb_ssl_args ssl_args "${db_ssl}"

    # Send the compressed dump as-is and gunzip it inside the container, so the
    # SSH-tunnelled Docker connection carries compressed bytes instead of plain
    # SQL — meaningfully faster for large dumps over a slow/distant link.
    # MYSQL_PWD is exported inside a subshell with tracing disabled so --debug
    # (set -x) never echoes the password; it stays scoped to the mariadb run and
    # is still forwarded via -e (not -p), so it never appears in argv either.
    #
    # --force: a dump from anywhere other than this same app's own db:export (a
    # plain mariadb-dump, ddev export-db, ...) can contain statements this
    # connection's user can't run as-is - e.g. a view's CREATE carrying a
    # DEFINER from wherever it was dumped, which fails with "Access denied;
    # you need ... SET USER ... privilege" for any other user (confirmed
    # against a real run). Without --force, mariadb aborts the whole import on
    # that first error, so the migration below - which is what actually
    # re-creates such a view correctly (db.migration, chained with a raw-SQL
    # step) - never even runs. --force logs the failing statement and moves
    # on instead, importing everything else; confirmed it also exits 0
    # (not just continuing past the error, but not failing this whole
    # subshell either), so it doesn't trip this script's own set -e before
    # reaching the migration step.
    (
        { set +x; } 2>/dev/null
        export MYSQL_PWD="${db_password}"
        docker run --rm -i -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            sh -c 'h="$1"; p="$2"; u="$3"; shift 3; gunzip -c | mariadb --force --default-character-set=utf8mb4 --host="$h" --port="$p" --user="$u" "$@"' \
            sh "${db_host}" "${db_port}" "${db_user}" "${ssl_args[@]}" "${db_name}" \
            < "${tmpfile}"
    )

    # The DB import already succeeded; a missing/ambiguous container here only
    # means the migration is skipped, so this is a warning, not a fatal error -
    # but get_container_id's own message (not suppressed here) explains WHICH:
    # zero matched, or multiple (e.g. a stale container left over from a
    # previous deploy) - a blanket "not found" wrongly implied the former even
    # when it was actually the latter, confirmed against a real run.
    if get_container_id container_id; then
        echo "Running database migration for ${APP_NAME}..."

        docker exec "${container_id}" \
            bash -lc "${DB_MIGRATION}"
    else
        echo "${COLOR_YELLOW}Warning: skipping migration - see above${COLOR_RESET}" >&2
    fi

elif [ "${command}" = "db:export" ]; then
    get_mariadb_credentials db_host db_name db_user db_password db_port db_ssl
    ensure_mariadb_image
    ssl_args=()
    mariadb_ssl_args ssl_args "${db_ssl}"

    # exclude_rows: schema kept, only rows skipped - applied to the data dump only.
    # exclude_tables: dropped entirely - applied to both the structure and data dump.
    rows_ignore_args=()
    resolve_ignore_table_args DB_EXCLUDE_ROWS rows_ignore_args \
        "${db_host}" "${db_port}" "${db_user}" "${db_password}" "${db_name}" "${db_ssl}"

    tables_ignore_args=()
    resolve_ignore_table_args DB_EXCLUDE_TABLES tables_ignore_args \
        "${db_host}" "${db_port}" "${db_user}" "${db_password}" "${db_name}" "${db_ssl}"

    # --default-character-set=utf8mb4 on every mariadb/mariadb-dump call (here and in
    # db:import below): without it, the client library's own default (latin1) silently
    # mangles multi-byte UTF-8 content on the way through - confirmed against a real
    # dump containing German typographic quotes, which corrupted into stray bytes that
    # broke SQL statement quoting entirely (not just mojibake) once re-imported.
    #
    # Dump structure and data separately, each gzip-compressed inside the
    # container before it crosses the SSH-tunnelled Docker connection, then
    # concatenated into one multi-member gzip stream on stdout (gunzip handles
    # concatenated gzip members transparently, decompressing back-to-back).
    # MYSQL_PWD is exported inside a subshell with tracing disabled so --debug
    # never echoes it, and forwarded via -e (not -p) so it never appears in argv.
    (
        { set +x; } 2>/dev/null
        export MYSQL_PWD="${db_password}"

        docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            sh -c 'h="$1"; p="$2"; u="$3"; shift 3; mariadb-dump --default-character-set=utf8mb4 --host="$h" --port="$p" --user="$u" --single-transaction --skip-lock-tables --no-data "$@" | gzip' \
            sh "${db_host}" "${db_port}" "${db_user}" "${ssl_args[@]}" "${tables_ignore_args[@]}" "${db_name}"

        docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            sh -c 'h="$1"; p="$2"; u="$3"; shift 3; mariadb-dump --default-character-set=utf8mb4 --host="$h" --port="$p" --user="$u" --single-transaction --skip-lock-tables --no-create-info "$@" | gzip' \
            sh "${db_host}" "${db_port}" "${db_user}" "${ssl_args[@]}" "${rows_ignore_args[@]}" "${tables_ignore_args[@]}" "${db_name}"
    )

elif [ "${command}" = "db:pull" ]; then
    # Local-dev convenience wrapper: db:export from the remote (host/
    # target_env already resolved above, passed through explicitly so the
    # child doesn't prompt again), decompressed into ddev's own importer for
    # the local project in the current working directory.
    if ! command -v ddev >/dev/null 2>&1; then
        echo "${COLOR_RED}Error: db:pull requires ddev on PATH (only db:export does not).${COLOR_RESET}" >&2
        exit 1
    fi
    # DOCKER_HOST='' - see run_yq's own comment on this: this shell already
    # has DOCKER_HOST=ssh://<remote host> exported for the remote side, which
    # ddev's own internal docker calls would otherwise inherit and query
    # instead of the local daemon its db container runs on.
    DDEP_CHILD_INVOCATION=true "$0" db:export "${host}" "${target_env}" | gzip -dc | DOCKER_HOST='' ddev import-db

elif [ "${command}" = "db:push" ]; then
    # Local-dev convenience wrapper, the reverse of db:pull: dumps the local
    # ddev project's database via `ddev export-db`, then applies this
    # project's own exclude_rows/exclude_tables by filtering the dump *text*
    # for mariadb-dump's own comment markers ("-- Table structure for table
    # `x`", "-- Dumping data for table `x`", "-- Temporary/Final table
    # structure for view `x`") - `ddev export-db` has no table-exclusion
    # option of its own, and `ddev exec` doesn't forward trailing arguments
    # to an inner script's "$@" the way `docker exec` does (confirmed against
    # a real project), which rules out mirroring db:export's --ignore-table
    # approach directly. exclude_tables suppresses a table/view's structure
    # and data both; exclude_rows only its data section.
    #
    # --force/--debug are forwarded to the db:import child invocation (which
    # is what actually prompts for confirmation), not consumed here.
    if ! command -v ddev >/dev/null 2>&1; then
        echo "${COLOR_RED}Error: db:push requires ddev on PATH (only db:import does not).${COLOR_RESET}" >&2
        exit 1
    fi

    rows_regex=$(IFS="|"; echo "${DB_EXCLUDE_ROWS[*]}")
    tables_regex=$(IFS="|"; echo "${DB_EXCLUDE_TABLES[*]}")

    import_args=()
    [[ "${FORCE}" == "true" ]] && import_args+=("--force")
    [[ "${DEBUG}" == "true" ]] && import_args+=("--debug")
    import_args+=("db:import" "${host}" "${target_env}")

    # DOCKER_HOST='' - see db:pull's own comment on this; same reasoning.
    DOCKER_HOST='' ddev export-db | gzip -dc | awk -v exclude_rows="${rows_regex}" -v exclude_tables="${tables_regex}" '
        BEGIN { suppress = 0 }
        /^-- Table structure for table `/ || /^-- Temporary table structure for view `/ {
            name = $0
            sub(/^-- (Table structure for table|Temporary table structure for view) `/, "", name)
            sub(/`.*/, "", name)
            suppress = (exclude_tables != "" && name ~ exclude_tables)
        }
        /^-- Dumping data for table `/ {
            name = $0
            sub(/^-- Dumping data for table `/, "", name)
            sub(/`.*/, "", name)
            suppress = (exclude_tables != "" && name ~ exclude_tables) || (exclude_rows != "" && name ~ exclude_rows)
        }
        /^-- Final view structure for view `/ {
            name = $0
            sub(/^-- Final view structure for view `/, "", name)
            sub(/`.*/, "", name)
            suppress = (exclude_tables != "" && name ~ exclude_tables)
        }
        { if (!suppress) print }
    ' | DDEP_CHILD_INVOCATION=true "$0" "${import_args[@]}"
fi
