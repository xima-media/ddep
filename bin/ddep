#!/usr/bin/env bash
# Requires bash >= 4.3 (mapfile, local -n, ${var,,}/${var^^}).
# macOS ships bash 3.2 by default: `brew install bash` and make sure it
# comes before /bin/bash in PATH.

set -euo pipefail
DEBUG=false
# Bumped on release; keep in sync with the git tag used for composer.
DDEP_VERSION="1.0.0"

# Same codes as docker-compose-deploy's own deploy.sh. Only when stderr is a
# terminal - never for output piped/redirected elsewhere (e.g. a CI log file).
COLOR_RED="" COLOR_YELLOW="" COLOR_CYAN="" COLOR_RESET=""
if [ -t 2 ]; then
    COLOR_RED=$'\033[91m'
    COLOR_YELLOW=$'\033[0;33m'
    COLOR_CYAN=$'\033[36m'
    COLOR_RESET=$'\033[0m'
fi

CONFIG_FILE=""

LOCAL_CONFIG_FILE="$(pwd)/.docker/ddep.json"
HOSTS_FILE="$(pwd)/.docker/hosts.yaml"
# Pinned by tag+digest, matching this org's convention elsewhere
# (docker-compose-deploy). See run_yq for why this isn't just "require yq on PATH".
YQ_IMAGE="mikefarah/yq:4.44.3@sha256:5b3d851bf28b04ef902fee86305f4dd7e063919c1cafedab2042adb16221c025"
# "app", "hosts", and "compose_projects_root" always come from .docker/hosts.yaml
# (required), never from .docker/ddep.json, even as a fallback - see
# load_hosts_config/load_config.
#   app <- all.vars.app_name
#   hosts.<host_key> <- "<ansible_user>@<ansible_host>" for every host, keyed by its
#     own hosts.yaml key (e.g. "ddep ssh customer_a" for one of several hosts under
#     a "live" group), plus hosts.<dev|test|live> as a convenience default resolving
#     to the FIRST host declared under that group (file order) - not reliable for
#     targeting one specific host once a group has more than one.
# See .docker/hosts.yaml's format (an Ansible inventory) in
# docker-compose-deploy's README ("Multi-host test/live").
#
# .docker/ddep.json is optional, scoped only to per-application setting overrides:
# {
#   "mariadb_version": "lts",                        # optional, overrides the built-in default
#   "settings": {                                     # optional, per-application overrides
#     "symfony": {
#       "db": {
#         "exclude_rows": ["^sessions$"],
#         "exclude_tables": ["^v_media_references_info$"]
#       }
#     }
#   }
# }
# db.exclude_rows: schema kept, only rows are skipped - for live per-environment
#   state (e.g. sessions) that the app's own schema still manages.
# db.exclude_tables: dropped entirely, structure and data both - for tables/views
#   that shouldn't exist in the dump at all (e.g. one exposing a DEFINER tied to
#   its origin server).
# A ddep.json still setting "app"/"hosts" (the pre-hosts.yaml schema) has both
# ignored, with a warning - see load_config.

# Requirements (local machine):
#   jq, docker, ssh, rsync, gzip
#   Must be run from inside the project's git working copy (the project name and
#   remote docker-compose directories are derived from `git remote get-url origin`).
#   Passwordless SSH access to the target host is required, since every command
#   makes at least one SSH/Docker-over-SSH round trip. A host not yet in your
#   known_hosts prompts to confirm it (see ensure_ssh_host_trusted) - answer
#   that first if running non-interactively (cron, a script).
#   .docker/hosts.yaml must exist, declaring at least "app" and one host.
#
# Usage:
#   ddep [options] <command> [host] [environment]
#
#   Options must come before the command, in any order among themselves. host
#   and environment are positional, after the command - both optional (see
#   below), except for "config" (takes neither) and "exec" (requires all
#   three positional args: host, environment, and the command to run).
#
# Commands:
#   media:push [host] [env]  Push local media files to the remote application container
#   media:pull [host] [env]  Pull media files from the remote application container
#   db:import [host] [env]   Import a database dump (read from stdin) into the remote
#                             database, then run the application's DB migration. A
#                             gzip-compressed stream is detected and passed through;
#                             plain SQL is gzip-compressed here before it is sent.
#   db:export [host] [env]   Export the remote database to stdout as a gzip stream.
#                             db.exclude_rows tables keep their schema but skip rows;
#                             db.exclude_tables tables/views are dropped entirely.
#   db:pull [host] [env]     Local-dev convenience wrapper: db:export from the
#                             remote, piped straight into `ddev import-db` for the
#                             ddev project in the current working directory.
#                             Requires ddev on PATH.
#   db:push [host] [env]     Local-dev convenience wrapper, the reverse of
#                             db:pull: dumps the local ddev project's database
#                             (same db.exclude_rows/db.exclude_tables filtering
#                             as db:export) and pipes it into db:import against
#                             the remote. Requires ddev on PATH.
#   ssh [host] [env]         Open an interactive shell inside the remote container
#   exec <host> <env> <cmd>  Execute a command inside the remote container (quote
#                             it as one argument if it contains spaces)
#   logs [host] [env]        Follow the remote application container's log output
#   config                   Print the resolved configuration (built-in defaults,
#                             .docker/hosts.yaml, and .docker/ddep.json, all
#                             deep-merged together) as JSON
#   info [host] [env]        Print details about the remote application container as
#                             JSON (currently just container_id; more may be added)
#
#   host                     Target host, from .docker/hosts.yaml. Default: dev
#   environment              Target remote environment slug. This is the part of
#                             the remote docker-compose project directory name
#                             after "<project>_", e.g. "feature_xyz" for a
#                             directory named "myproject_feature_xyz". Default:
#                             interactively pick from the environments currently
#                             deployed on host
#
# Options:
#   -h, --help              Show usage and exit
#   -V, --version           Show version and exit
#   --debug                 Enable bash execution tracing
#   --force                 Skip the confirmation prompt for destructive
#                           operations (db:import, media:push). Required for
#                           non-interactive/CI use.
#
# Configuration:
#   Built-in defaults, deep-merged with .docker/ddep.json (optional, per-application
#   setting overrides), overlaid with .docker/hosts.yaml's "app"/"hosts"/
#   "compose_projects_root" - all three required, and exclusively hosts.yaml's (ddep.json
#   setting them is ignored, with a warning) - see the schema above.
#
# Examples:
#
#   # Pull media from the test environment
#   ddep media:pull test development
#
#   # Push local media to the dev environment
#   ddep media:push dev feature_xyz
#
#   # Open an interactive shell in the dev application container
#   ddep ssh dev
#
#   # Execute a command inside the dev application container
#   ddep exec dev feature_xyz "vendor/bin/typo3 list"
#
#   # Follow the dev application container's log output
#   ddep logs dev
#
#   # Import a database dump into the dev environment (plain SQL or gzip, both work)
#   ddep db:import dev feature_xyz < dump.sql.gz
#
#   # Export the dev database to a dump file (already gzip-compressed)
#   ddep db:export dev feature_xyz > dump.sql.gz
#
#   # Pipe an existing dump directly into the remote database
#   cat dump.sql.gz | ddep db:import dev feature_xyz
#
#   # Pull the dev database straight into the local ddev project (requires ddev)
#   ddep db:pull dev feature_xyz
#
#   # Push the local ddev project's database to the dev environment (requires ddev)
#   ddep db:push dev feature_xyz
#
#   # Export a remote TYPO3 database (plain SQL) and import it locally
#   ssh dev@vm "cd /var/www/html/typo3/current && vendor/bin/typo3 database:export" \
#       | ddep db:import dev branch-69
#
#   # Inspect the fully resolved configuration (no git repo, host or env needed)
#   ddep config
#   ddep config | jq '.settings.symfony.rsync'
#
#   # Get the dev environment's container id (e.g. for reset-job tooling)
#   ddep info dev feature_xyz | jq -r '.container_id'

# Functions
usage() {
    cat <<'EOF'
Usage: ddep [options] <command> [host] [environment]

Commands:
  media:push [host] [env]  Push local media files to the remote application container
  media:pull [host] [env]  Pull media files from the remote application container
  db:import [host] [env]   Import a database dump (stdin, plain SQL or gzip) into
                            the remote DB, then migrate
  db:export [host] [env]   Export the remote database to stdout, gzip-compressed
  db:pull [host] [env]     db:export piped into `ddev import-db` (requires ddev)
  db:push [host] [env]     Local ddev database dump piped into db:import (requires ddev)
  ssh [host] [env]         Open an interactive shell in the remote container
  exec <host> <env> <cmd>  Run a command in the remote container (quote it as
                            one argument if it contains spaces)
  logs [host] [env]        Follow the remote application container's log output
  config                   Print the resolved configuration as JSON
  info [host] [env]        Print details about the remote application container as JSON

  host        Target host from .docker/hosts.yaml (default: dev)
  environment Target environment slug (default: interactive pick)

Options:
  --force         Skip confirmation for destructive ops (db:import, media:push)
  --debug         Enable bash execution tracing
  -h, --help      Show this help and exit
  -V, --version   Show version and exit
EOF
}

check_requirements() {
    local missing=()
    local cmd
    for cmd in docker jq ssh rsync gzip git; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "${COLOR_RED}Error: required command(s) not found on PATH: ${missing[*]}${COLOR_RESET}" >&2
        exit 1
    fi

    if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
        echo "${COLOR_RED}Error: bash >= 4.3 required, but running ${BASH_VERSION}." >&2
        echo "       On macOS: brew install bash (and put it before /bin/bash on PATH).${COLOR_RESET}" >&2
        exit 1
    fi
}

