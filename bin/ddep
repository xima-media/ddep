#!/usr/bin/env bash
# Requires bash >= 4.3 (mapfile, local -n, ${var,,}/${var^^}).
# macOS ships bash 3.2 by default: `brew install bash` and make sure it
# comes before /bin/bash in PATH.

set -euo pipefail
DEBUG=false
# Bumped on release; keep in sync with the git tag used for composer.
DDEP_VERSION="1.0.0"

CONFIG_FILE=""

LOCAL_CONFIG_FILE="$(pwd)/.docker/ddep.json"
# .docker/ddep.json (deep-merged over the script's built-in defaults; any key,
# including nested application settings, fully replaces its default when set
# locally rather than appending to it):
# {
#   "app": "symfony",                       # required, must match a key under "settings" below
#
#   "hosts": {                              # required, at least one entry
#     "dev": "user@dev-host",
#     "test": "user@test-host",
#     "live": "user@live-host"
#   },
#
#   "environments_path": "/opt/docker/compose",  # optional, overrides the built-in default
#   "mariadb_version": "lts",                    # optional, overrides the built-in default
#
#   "settings": {                            # optional, overrides built-in per-application settings
#     "symfony": {
#       "db": {
#         "exclude_tables": [               # replaces the application's built-in exclude list
#           "^sessions$",
#           "^v_media_references_info$"
#         ]
#       }
#     }
#   }
# }

# Requirements (local machine):
#   jq, docker, ssh, rsync, gzip
#   Must be run from inside the project's git working copy (the project name and
#   remote docker-compose directories are derived from `git remote get-url origin`).
#   Passwordless SSH access to the target host is required, since every command
#   makes at least one SSH/Docker-over-SSH round trip.
#
# Usage:
#   ddep [options] <command>
#
#   Options may appear before or after the command, in any order.
#
# Commands:
#   media:push              Push local media files to the remote application container
#   media:pull              Pull media files from the remote application container
#   db:push                 Import a database dump (read from stdin) into the remote
#                           database, then run the application's DB migration
#   db:pull                 Export the remote database to stdout. Tables matching
#                           db.exclude_tables are dumped structure-only (no rows),
#                           so they still exist after a db:push, even on a
#                           brand-new environment that never had them before.
#   ssh [command]           Open a shell or execute a command inside the remote container
#   logs                    Follow the remote application container's log output
#   config                  Print the resolved configuration (.docker/ddep.json
#                           deep-merged over the built-in defaults) as JSON
#   info                    Print details about the remote application container as
#                           JSON (currently just container_id; more may be added)
#
# Options:
#   -h, --help              Show usage and exit
#   -V, --version           Show version and exit
#   --debug                 Enable bash execution tracing
#   --force                 Skip the confirmation prompt for destructive
#                           operations (db:push, media:push). Required for
#                           non-interactive/CI use.
#   --host <host>           Target host from .docker/ddep.json
#                           Default: dev
#
#   --env <environment>     Target remote environment slug. This is the part of the
#                           remote docker-compose project directory name after
#                           "<project>_", e.g. "feature_xyz" for a directory named
#                           "myproject_feature_xyz".
#                           Default: interactively pick from the environments
#                           currently deployed on --host
#
# Configuration:
#   Default configuration (environments_path, mariadb_version, and the per-application
#   db/rsync settings) is built into the script. Project-specific configuration is
#   loaded from .docker/ddep.json and deep-merged on top — see the schema above.
#
# Examples:
#
#   # Pull media from the test environment
#   ddep --host test media:pull --env development
#
#   # Push local media to the dev environment
#   ddep --host dev media:push --env feature_xyz
#
#   # Open an interactive shell in the dev application container
#   ddep --host dev ssh
#
#   # Execute a command inside the dev application container
#   ddep --host dev ssh "vendor/bin/typo3 list"
#
#   # Follow the dev application container's log output
#   ddep --host dev logs
#
#   # Import a database dump into the dev environment
#   ddep --host dev db:push --env feature_xyz < dump.sql
#
#   # Export the dev database to a dump file
#   ddep --host dev db:pull --env feature_xyz > dump.sql
#
#   # Pipe an existing dump directly into the remote database
#   cat dump.sql | ddep --host dev db:push --env feature_xyz
#
#   # Export a remote TYPO3 database and import it locally
#   ssh dev@vm "cd /var/www/html/typo3/current && vendor/bin/typo3 database:export" \
#       | ddep --host dev --env branch-69 db:push
#
#   # Inspect the fully resolved configuration (no git repo, host or env needed)
#   ddep config
#   ddep config | jq '.settings.symfony.rsync'
#
#   # Get the dev environment's container id (e.g. for reset-job tooling)
#   ddep --host dev --env feature_xyz info | jq -r '.container_id'

# Functions
usage() {
    cat <<'EOF'
Usage: ddep [options] <command>

Commands:
  media:push   Push local media files to the remote application container
  media:pull   Pull media files from the remote application container
  db:push      Import a database dump (stdin) into the remote DB, then migrate
  db:pull      Export the remote database to stdout
  ssh [cmd]    Open a shell, or run a command, in the remote container
  logs         Follow the remote application container's log output
  config       Print the resolved configuration as JSON
  info         Print details about the remote application container as JSON

Options:
  --host <host>   Target host from .docker/ddep.json (default: dev)
  --env <env>     Target environment slug (default: interactive pick)
  --force         Skip confirmation for destructive ops (db:push, media:push)
  --debug         Enable bash execution tracing
  -h, --help      Show this help and exit
  -V, --version   Show version and exit
EOF
}

check_requirements() {
    local missing=()
    local cmd
    for cmd in docker jq ssh rsync gzip git; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "Error: required command(s) not found on PATH: ${missing[*]}" >&2
        exit 1
    fi

    if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
        echo "Error: bash >= 4.3 required, but running ${BASH_VERSION}." >&2
        echo "       On macOS: brew install bash (and put it before /bin/bash on PATH)." >&2
        exit 1
    fi
}

load_default_config() {
    cat <<'JSON'
{
  "environments_path": "/opt/docker/compose",
  "mariadb_version": "lts",
  "settings": {
    "typo3": {
      "db": {
        "migration": "/usr/bin/php vendor/bin/typo3 database:updateschema --no-interaction --quiet",
        "env": {
          "host": "TYPO3_CONF_VARS__DB__Connections__Default__host",
          "dbname": "TYPO3_CONF_VARS__DB__Connections__Default__dbname",
          "user": "TYPO3_CONF_VARS__DB__Connections__Default__user",
          "password": "TYPO3_CONF_VARS__DB__Connections__Default__password",
          "port": "TYPO3_CONF_VARS__DB__Connections__Default__port"
        },
        "exclude_tables": [
          "^cf_.*",
          "^cache_.*",
          "^be_sessions$",
          "^fe_sessions$",
          "^fe_session_data$",
          "^sys_file_processedfile$",
          "^sys_http_report$",
          "^sys_refindex$",
          "^tx_devlog$",
          "^tx_extensionmanager_domain_model_extension$",
          "^tx_solr_.*",
          "^tx_crawler_queue$",
          "^tx_crawler_process$"
        ]
      },
      "rsync": {
        "max_size_mb": 5,
        "remote_path": "/var/www/html/app/public",
        "directories": [
          "fileadmin",
          "uploads"
        ],
        "exclude_paths": [
          "_processed_",
          "_temp_"
        ],
        "exclude_extensions": [
          "mp4",
          "zip",
          "pdf",
          "exe",
          "doc",
          "docx",
          "pptx",
          "ppt",
          "xls",
          "xlsx",
          "xlsm",
          "tiff",
          "tif",
          "potx",
          "mpg",
          "mp3",
          "avi",
          "wmv",
          "flv",
          "eps",
          "ai",
          "mov"
        ]
      }
    },

    "symfony": {
      "db": {
        "migration": "/usr/bin/php bin/console doctrine:migrations:migrate --no-interaction --quiet",
        "env": {
          "host": "SYMFONY_DATABASE_HOST",
          "dbname": "SYMFONY_DATABASE_DBNAME",
          "user": "SYMFONY_DATABASE_USER",
          "password": "SYMFONY_DATABASE_PASSWORD",
          "port": "SYMFONY_DATABASE_PORT"
        },
        "exclude_tables": [
          "^sessions$"
        ]
      },
      "rsync": {
        "max_size_mb": 5,
        "remote_path": "/var/www/html/app/public",
        "directories": [
          "upload"
        ],
        "exclude_paths": [
          "thumb",
          "thumb_*"
        ],
        "exclude_extensions": [
          "mp4",
          "zip",
          "pdf",
          "exe",
          "doc",
          "docx",
          "pptx",
          "ppt",
          "xls",
          "xlsx",
          "xlsm",
          "tiff",
          "tif",
          "potx",
          "mpg",
          "mp3",
          "avi",
          "wmv",
          "flv",
          "eps",
          "ai",
          "mov"
        ]
      }
    }
  }
}
JSON
}

load_config() {
    local local_config="${LOCAL_CONFIG_FILE}"

    CONFIG_FILE=$(mktemp)

    if [[ ! -f "${local_config}" ]]; then
        echo "Error: ${local_config} missing" >&2
        exit 1
    fi

    jq -n \
        --slurpfile default <(load_default_config) \
        --slurpfile local "${local_config}" \
        '
        def deepmerge(a;b):
            reduce (b | keys[]) as $key (
                a;
                if (.[$key] | type) == "object"
                   and (b[$key] | type) == "object"
                then
                    .[$key] = deepmerge(.[$key]; b[$key])
                else
                    .[$key] = b[$key]
                end
            );

        deepmerge($default[0]; $local[0])
        ' > "${CONFIG_FILE}"
}

validate_config() {
    local missing=()

    if [[ "$(jq -r '.app // empty' "${CONFIG_FILE}")" == "" ]]; then
        missing+=("app")
    fi

    if [[ "$(jq -r '.hosts // empty' "${CONFIG_FILE}")" == "" ]]; then
        missing+=("hosts")
    fi

    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "Error: missing required configuration: ${missing[*]}" >&2
        exit 1
    fi
}

parse_config_json() {
    # validate_config already guarantees .app is present and non-empty
    APP_NAME=$(jq -r '.app' "${CONFIG_FILE}")

    APP_CONFIG=".settings[\"${APP_NAME}\"]"
    if [[ "$(jq -r "${APP_CONFIG} // empty" "${CONFIG_FILE}")" == "" ]]; then
        echo "Error: app '${APP_NAME}' is not defined in default configuration" >&2
        exit 1
    fi

    ENVIRONMENTS_PATH=$(jq -r '.environments_path' "${CONFIG_FILE}")
    ENVIRONMENTS_PATH="${ENVIRONMENTS_PATH%/}"

    if [[ -z "${ENVIRONMENTS_PATH}" || "${ENVIRONMENTS_PATH}" == "null" ]]; then
        echo "Error: environments_path is missing" >&2
        exit 1
    fi

    MARIADB_VERSION=$(jq -r '.mariadb_version // "lts"' "${CONFIG_FILE}")

    REMOTE_DOCKER_HOST=$(jq -r ".hosts.${host} // empty" "${CONFIG_FILE}")

    if [[ -z "${REMOTE_DOCKER_HOST}" ]]; then
        echo "Error: host '${host}' is not configured" >&2
        exit 1
    fi

    # Database configuration
    DB_MIGRATION=$(jq -r "${APP_CONFIG}.db.migration" "${CONFIG_FILE}")

    DB_ENV_HOST=$(jq -r "${APP_CONFIG}.db.env.host" "${CONFIG_FILE}")
    DB_ENV_DBNAME=$(jq -r "${APP_CONFIG}.db.env.dbname" "${CONFIG_FILE}")
    DB_ENV_USER=$(jq -r "${APP_CONFIG}.db.env.user" "${CONFIG_FILE}")
    DB_ENV_PASSWORD=$(jq -r "${APP_CONFIG}.db.env.password" "${CONFIG_FILE}")
    DB_ENV_PORT=$(jq -r "${APP_CONFIG}.db.env.port" "${CONFIG_FILE}")


    # Rsync configuration
    RSYNC_MAX_SIZE_MB=$(jq -r "${APP_CONFIG}.rsync.max_size_mb" "${CONFIG_FILE}")

    RSYNC_REMOTE_PATH=$(jq -r "${APP_CONFIG}.rsync.remote_path" "${CONFIG_FILE}")
    RSYNC_REMOTE_PATH="${RSYNC_REMOTE_PATH%/}"

    mapfile -t RSYNC_DIRECTORIES < <(
        jq -r "${APP_CONFIG}.rsync.directories[]" "${CONFIG_FILE}"
    )

    mapfile -t RSYNC_EXCLUDE_PATHS < <(
        jq -r "${APP_CONFIG}.rsync.exclude_paths[]" "${CONFIG_FILE}"
    )

    mapfile -t RSYNC_EXCLUDE_EXTENSIONS < <(
        jq -r "${APP_CONFIG}.rsync.exclude_extensions[]" "${CONFIG_FILE}"
    )


    # Database table exclusions
    mapfile -t DB_EXCLUDE_TABLES < <(
        jq -r "(${APP_CONFIG}.db.exclude_tables // []) | .[]" "${CONFIG_FILE}"
    )
}

get_env_value() {
    awk -F= -v key="$1" '$1 == key {print $2}'
}


get_mariadb_credentials() {
    local -n _mariadb_host=$1
    local -n _mariadb_name=$2
    local -n _mariadb_user=$3
    local -n _mariadb_password=$4
    local -n _mariadb_port=$5

    local environment_file_path="${ENVIRONMENTS_PATH}/${git_project_name}_${target_env}/.app.env.provision"

    if ! ssh "${REMOTE_DOCKER_HOST}" "test -f '${environment_file_path}'"; then
        echo "Error: ${environment_file_path} missing" >&2
        exit 1
    fi

    # The env file holds the database password and every other application secret,
    # so keep the whole read/parse out of the --debug trace: set -x would echo
    # both the full file contents and the parsed password. env_content is scoped
    # to this function so those secrets do not linger in a global afterwards.
    { set +x; } 2>/dev/null

    local env_content
    env_content=$(ssh "${REMOTE_DOCKER_HOST}" "cat '${environment_file_path}'")

    _mariadb_host=$(get_env_value "${DB_ENV_HOST}" <<< "${env_content}")
    _mariadb_name=$(get_env_value "${DB_ENV_DBNAME}" <<< "${env_content}")
    _mariadb_user=$(get_env_value "${DB_ENV_USER}" <<< "${env_content}")
    _mariadb_password=$(get_env_value "${DB_ENV_PASSWORD}" <<< "${env_content}")
    _mariadb_port=$(get_env_value "${DB_ENV_PORT}" <<< "${env_content}")

    _mariadb_port=${_mariadb_port:-3306}

    if [[ "${DEBUG}" == "true" ]]; then
        set -x
    fi
}

ensure_mariadb_image() {
    local image="mariadb:${MARIADB_VERSION}"
    local output
    if ! output="$(docker pull "${image}" 2>&1)"; then
        # A pull can fail transiently or offline; only fatal if the image is not
        # already available on the (remote) daemon.
        if ! docker image inspect "${image}" >/dev/null 2>&1; then
            echo "Error: could not pull ${image} and it is not available:" >&2
            echo "${output}" >&2
            exit 1
        fi
        echo "Warning: could not refresh ${image}; using the existing image." >&2
    fi
}

rsync_exclude_params() {
    rsync_exclude_params=()

    for _exclude_path in "${RSYNC_EXCLUDE_PATHS[@]}"; do
        rsync_exclude_params+=("--exclude=**/${_exclude_path}")
    done

    for _exclude_extension in "${RSYNC_EXCLUDE_EXTENSIONS[@]}"; do
        rsync_exclude_params+=("--exclude=*.${_exclude_extension,,}")
        rsync_exclude_params+=("--exclude=*.${_exclude_extension^^}")
    done
}

get_container_id() {
    # Returns 0 and sets the nameref when exactly one container matches.
    # Returns 1 (no match) or 2 (more than one match) and prints a specific
    # message to stderr, so callers can tell the two failure modes apart instead
    # of reporting every failure as "not found".
    local -n _container_id=$1
    local environment_path="${ENVIRONMENTS_PATH}/${git_project_name}_${target_env}"
    local ids
    ids=$(docker ps -q \
        --filter "label=com.docker.compose.project.working_dir=${environment_path}" \
        --filter "label=com.docker.compose.service=${APP_NAME}")

    if [ -z "$ids" ]; then
        echo "Error: no container found for project '${git_project_name}', environment '${target_env}', service '${APP_NAME}'." >&2
        return 1
    fi

    if [ "$(printf '%s\n' "$ids" | wc -l)" -gt 1 ]; then
        echo "Error: multiple containers matched project '${git_project_name}', environment '${target_env}', service '${APP_NAME}':" >&2
        printf '%s\n' "$ids" | sed 's/^/  /' >&2
        return 2
    fi

    _container_id=$ids
    return 0
}

get_available_remote_envs() {
    docker ps -a \
        --filter "label=com.docker.compose.service=${APP_NAME}" \
        --format '{{.Label "com.docker.compose.project.working_dir"}}' \
    | grep "/${git_project_name}_" \
    | sed "s|.*/${git_project_name}_||" \
    | sort -u
}

select_env() {
    local envs=()

    mapfile -t envs < <(get_available_remote_envs)

    if [[ "${#envs[@]}" -eq 0 ]]; then
        echo "Error: no remote environments found on host ${host}" >&2
        exit 1
    fi

    # The picker reads from the controlling terminal (not stdin, which may be a
    # pipe, e.g. db:push). Without a terminal (CI), --env must be given explicitly.
    if [[ ! -r /dev/tty ]]; then
        echo "Error: no --env given and no terminal available to choose one." >&2
        echo "       Pass --env <environment> explicitly." >&2
        exit 1
    fi

    echo "Select environment on ${host}:" >&2

    PS3="Environment: "
    select env in "${envs[@]}"; do
        if [[ -n "${env}" ]]; then
            printf '%s\n' "${env}"
            return
        fi

        echo "Invalid selection" >&2
    done < /dev/tty
}

confirm_destructive() {
    # $1 = human-readable description of the destructive action.
    # Confirmation is read from the controlling terminal (/dev/tty), not stdin,
    # because db:push consumes stdin. Non-dev hosts require typing the host slug
    # for extra safety; non-interactive runs (CI, no TTY) must pass --force.
    local action="$1"
    local expected="yes"
    local answer=""

    if [[ "${FORCE}" == "true" ]]; then
        return 0
    fi

    if [[ "${host}" != "dev" ]]; then
        expected="${host}"
    fi

    if [[ ! -r /dev/tty ]]; then
        echo "Error: refusing to ${action}" >&2
        echo "       on host '${host}' (${target_env}) without confirmation." >&2
        echo "       No terminal available; re-run with --force to proceed." >&2
        exit 1
    fi

    echo "WARNING: about to ${action}" >&2
    echo "         host '${host}' (${REMOTE_DOCKER_HOST}), environment '${target_env}'." >&2
    printf "Type '%s' to continue: " "${expected}" >&2
    read -r answer < /dev/tty

    if [[ "${answer}" != "${expected}" ]]; then
        echo "Aborted." >&2
        exit 1
    fi
}

# Allow sourcing (e.g. from tests) to load the functions above without running
# the CLI below.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    return 0
fi

# Main script execution
command=""
host=""
tmpfile=""
ssh_args=()
FORCE=false

# Populated via namerefs by get_container_id and get_mariadb_credentials.
container_id=""
db_host=""
db_name=""
db_user=""
db_password=""
db_port=""

cleanup() {
    # Preserve the triggering exit status: under set -e, a failing last command
    # in an EXIT trap would otherwise become the script's exit code.
    local exit_code=$?
    [[ -n "${CONFIG_FILE:-}" ]] && rm -f "${CONFIG_FILE}"
    [[ -n "${tmpfile:-}" ]] && rm -f "${tmpfile}"
    exit "${exit_code}"
}
trap cleanup EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            echo "ddep ${DDEP_VERSION}"
            exit 0
            ;;
        --debug)
            DEBUG=true
            shift
            ;;
        --host)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "Error: --host requires a value" >&2
                exit 1
            fi
            host="$2"
            shift 2
            ;;
        --env)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "Error: --env requires a value" >&2
                exit 1
            fi
            target_env="$2"
            shift 2
            ;;
        --force)
            FORCE=true
            shift
            ;;
        media:push|media:pull|db:push|db:pull|logs|config|info)
            command="$1"
            shift
            ;;
        ssh)
            command="$1"
            shift
            # Everything after "ssh" is the command to run in the container. As with
            # "ssh host <cmd>", the arguments are joined with spaces and executed by
            # the container shell, so quote a command containing spaces as one string.
            if [[ $# -gt 0 ]]; then
                ssh_args+=("$@")
                shift $#
            fi
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done
if [ -z "${command}" ]; then
    echo "No command provided. Use one of: media:push, media:pull, ssh, db:push, db:pull, logs, config, info" >&2
    exit 1
fi

check_requirements

if [[ "${DEBUG}" == "true" ]]; then
    set -x
fi

# Set defaults if not provided
if [ -z "${host}" ]; then
    host="dev"
fi

# config only inspects .docker/ddep.json merged with the built-in defaults; it
# does not touch git, docker or any remote host, and intentionally skips
# validate_config so a broken local config can still be inspected.
if [ "${command}" = "config" ]; then
    load_config
    jq '.' "${CONFIG_FILE}"
    exit 0
fi

# Needed before Docker environment lookup; the project name comes from the origin
# remote, so ddep must run inside a git working copy that has one.
if ! origin_url="$(git remote get-url origin 2>/dev/null)"; then
    echo "Error: could not determine the project name." >&2
    echo "       ddep must be run from inside a git working copy with an 'origin' remote." >&2
    exit 1
fi
git_project_name="$(basename "${origin_url}")"
git_project_name="${git_project_name%.git}"

load_config
validate_config
parse_config_json

export DOCKER_HOST="ssh://${REMOTE_DOCKER_HOST}"

if [[ -z "${target_env:-}" ]]; then
    target_env="$(select_env)"
fi

# Run commands
if [ "${command}" = "media:push" ]; then
    confirm_destructive "overwrite media files in the remote container"
    rsync_exclude_params
    if ! get_container_id container_id; then
        exit 1
    fi

    for dir in "${RSYNC_DIRECTORIES[@]}"; do
        if [[ ! -d "$(pwd)/public/${dir}" ]]; then
            echo "Directory public/${dir} does not exist, skipping..."
            continue
        fi
        rsync -e 'docker exec -i' -avz "--max-size=${RSYNC_MAX_SIZE_MB}m" "${rsync_exclude_params[@]}" "$(pwd)/public/${dir}" "${container_id}:${RSYNC_REMOTE_PATH}/"
    done

elif [ "${command}" = "media:pull" ]; then
    rsync_exclude_params
    if ! get_container_id container_id; then
        exit 1
    fi

    for dir in "${RSYNC_DIRECTORIES[@]}"; do
        if ! docker exec "${container_id}" [ -d "${RSYNC_REMOTE_PATH}/${dir}" ]; then
            echo "Directory ${RSYNC_REMOTE_PATH}/${dir} does not exist in container, skipping..."
            continue
        fi
        # ensure local target directory exists
        mkdir -p "$(pwd)/public/${dir}"
        rsync -e 'docker exec -i' -avz "--max-size=${RSYNC_MAX_SIZE_MB}m" "${rsync_exclude_params[@]}" "${container_id}:${RSYNC_REMOTE_PATH}/${dir}" "$(pwd)/public/"
    done

elif [ "${command}" = "ssh" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    # Only allocate a TTY (-t) when running interactively; in CI/pipes -t fails
    # with "the input device is not a TTY".
    exec_flags="-i"
    if [ -t 0 ] && [ -t 1 ]; then
        exec_flags="-it"
    fi
    if [ "${#ssh_args[@]}" -gt 0 ]; then
        # "${ssh_args[*]}" joins the arguments with a space into one command line
        # for the container shell to parse (ssh-style); no args opens a shell.
        docker exec "${exec_flags}" "${container_id}" /bin/bash -c "${ssh_args[*]}"
    else
        docker exec "${exec_flags}" "${container_id}" /bin/bash
    fi

elif [ "${command}" = "logs" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    docker logs -f "${container_id}"

elif [ "${command}" = "info" ]; then
    if ! get_container_id container_id; then
        exit 1
    fi
    jq -n --arg container_id "${container_id}" '{container_id: $container_id}'

elif [ "${command}" = "db:push" ]; then
    if [ -t 0 ]; then
        echo "Error: db:push reads the SQL dump from stdin; pipe one in, e.g.:" >&2
        echo "       ddep --host dev db:push < dump.sql" >&2
        exit 1
    fi

    # Create temporary file for compressed mysqldump from stdin; cleanup runs via the global EXIT trap
    tmpfile=$(mktemp)
    gzip -c > "$tmpfile"

    # gzip always writes a header, so empty stdin yields a valid-but-empty archive;
    # verify the decompressed stream actually contains data before proceeding.
    if [ -z "$(gunzip -c "${tmpfile}" | head -c1)" ]; then
        echo "Error: no data received on stdin; aborting db:push." >&2
        exit 1
    fi

    confirm_destructive "overwrite the remote database and run migrations"

    get_mariadb_credentials db_host db_name db_user db_password db_port
    ensure_mariadb_image

    # Import database dump from stdin and gunzip on the fly into the remote database.
    # MYSQL_PWD is exported inside a subshell with tracing disabled so --debug
    # (set -x) never echoes the password; it stays scoped to the mariadb run and
    # is still forwarded via -e (not -p), so it never appears in argv either.
    (
        { set +x; } 2>/dev/null
        export MYSQL_PWD="${db_password}"
        gunzip -c "${tmpfile}" | docker run --rm -i -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            mariadb --host="${db_host}" --port="${db_port}" --user="${db_user}" \
            "${db_name}"
    )

    # The DB import already succeeded; a missing/ambiguous container here only
    # means the migration is skipped, so this is a warning, not a fatal error.
    # Suppress get_container_id's own message and keep the softer warning.
    if get_container_id container_id 2>/dev/null; then
        echo "Running database migration for ${APP_NAME}..."

        docker exec "${container_id}" \
            bash -lc "${DB_MIGRATION}"
    else
        echo "Warning: container ${APP_NAME} not found, skipping migration" >&2
    fi

elif [ "${command}" = "db:pull" ]; then
    get_mariadb_credentials db_host db_name db_user db_password db_port
    ensure_mariadb_image

    ignore_args=()

    if [ "${#DB_EXCLUDE_TABLES[@]}" -gt 0 ]; then
        # Convert JSON regex array into MariaDB REGEXP expression
        regex=$(IFS="|"; echo "${DB_EXCLUDE_TABLES[*]}")

        # MYSQL_PWD is exported with tracing disabled so --debug never echoes it,
        # and forwarded via -e (not -p) so it never appears in argv either.
        tables=$(
            { set +x; } 2>/dev/null
            export MYSQL_PWD="${db_password}"
            docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            sh -c "mariadb \
                --host '${db_host}' \
                --port '${db_port}' \
                --user '${db_user}' \
                -N -e \"
                SELECT TABLE_NAME
                FROM information_schema.tables
                WHERE table_schema='${db_name}'
                AND TABLE_NAME REGEXP '${regex}';
                \"")

        for table in ${tables}; do
            ignore_args+=( "--ignore-table=${db_name}.${table}" )
        done
    fi

    # Dump structure and data separately, concatenated into one stdout stream.
    # The structure half covers every table, INCLUDING ones in exclude_tables, so
    # an excluded table (e.g. a sessions table) still exists — with the correct,
    # empty schema — after a db:push, even on a brand-new environment that never
    # had it. Only its rows are skipped, by the data half below.
    # MYSQL_PWD is exported inside a subshell with tracing disabled so --debug
    # never echoes it, and forwarded via -e (not -p) so it never appears in argv.
    (
        { set +x; } 2>/dev/null
        export MYSQL_PWD="${db_password}"

        docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            mariadb-dump \
            --host "${db_host}" \
            --port "${db_port}" \
            --user "${db_user}" \
            --single-transaction \
            --skip-lock-tables \
            --no-data \
            "${db_name}"

        docker run --rm -e MYSQL_PWD "mariadb:${MARIADB_VERSION}" \
            mariadb-dump \
            --host "${db_host}" \
            --port "${db_port}" \
            --user "${db_user}" \
            --single-transaction \
            --skip-lock-tables \
            --no-create-info \
            "${ignore_args[@]}" \
            "${db_name}"
    )
fi
