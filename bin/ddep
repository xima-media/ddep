#!/usr/bin/env bash
# Requires bash >= 4.3 (mapfile, local -n, ${var,,}/${var^^}).
# macOS ships bash 3.2 by default: `brew install bash` and make sure it
# comes before /bin/bash in PATH.

set -euo pipefail
DEBUG=false
# Bumped on release; keep in sync with the git tag used for composer.
DDEP_VERSION="1.0.0"

CONFIG_FILE=""

LOCAL_CONFIG_FILE="$(pwd)/.docker/ddep.json"
HOSTS_FILE="$(pwd)/.docker/hosts.yaml"
# Pinned by tag+digest, matching this org's convention elsewhere
# (docker-compose-deploy). See run_yq for why this isn't just "require yq on PATH".
YQ_IMAGE="mikefarah/yq:4.44.3@sha256:5b3d851bf28b04ef902fee86305f4dd7e063919c1cafedab2042adb16221c025"
# "app", "hosts", and "compose_projects_root" always come from .docker/hosts.yaml
# (required), never from .docker/ddep.json, even as a fallback - see
# load_hosts_config/load_config.
#   app <- all.vars.app_name
#   hosts.<host_key> <- "<ansible_user>@<ansible_host>" for every host, keyed by its
#     own hosts.yaml key (e.g. --host customer_a for one of several hosts under a
#     "live" group), plus hosts.<dev|test|live> as a convenience default resolving
#     to the FIRST host declared under that group (file order) - not reliable for
#     targeting one specific host once a group has more than one.
# See .docker/hosts.yaml's format (an Ansible inventory) in
# docker-compose-deploy's README ("Multi-host test/live").
#
# .docker/ddep.json is optional, scoped only to per-application setting overrides:
# {
#   "mariadb_version": "lts",                        # optional, overrides the built-in default
#   "settings": {                                     # optional, per-application overrides
#     "symfony": {
#       "db": {
#         "exclude_tables": ["^sessions$", "^v_media_references_info$"]
#       }
#     }
#   }
# }
# A ddep.json still setting "app"/"hosts" (the pre-hosts.yaml schema) has both
# ignored, with a warning - see load_config.

# Requirements (local machine):
#   jq, docker, ssh, rsync, gzip
#   Must be run from inside the project's git working copy (the project name and
#   remote docker-compose directories are derived from `git remote get-url origin`).
#   Passwordless SSH access to the target host is required, since every command
#   makes at least one SSH/Docker-over-SSH round trip. A host not yet in your
#   known_hosts prompts to confirm it (see ensure_ssh_host_trusted) - answer
#   that first if running non-interactively (cron, a script).
#   .docker/hosts.yaml must exist, declaring at least "app" and one host.
#
# Usage:
#   ddep [options] <command>
#
#   Options must come before the command, in any order among themselves. For
#   "ssh", everything after the command is the container command instead - see
#   below. Every other command takes no further arguments.
#
# Commands:
#   media:push              Push local media files to the remote application container
#   media:pull              Pull media files from the remote application container
#   db:push                 Import a database dump (read from stdin) into the remote
#                           database, then run the application's DB migration. A
#                           gzip-compressed stream is detected and passed through;
#                           plain SQL is gzip-compressed here before it is sent.
#   db:pull                 Export the remote database to stdout as a gzip stream.
#                           Tables matching db.exclude_tables are dumped
#                           structure-only (no rows), so they still exist after a
#                           db:push, even on a brand-new environment that never
#                           had them before.
#   ssh [command]           Open a shell or execute a command inside the remote container
#   logs                    Follow the remote application container's log output
#   config                  Print the resolved configuration (built-in defaults,
#                           .docker/hosts.yaml, and .docker/ddep.json, all
#                           deep-merged together) as JSON
#   info                    Print details about the remote application container as
#                           JSON (currently just container_id; more may be added)
#
# Options:
#   -h, --help              Show usage and exit
#   -V, --version           Show version and exit
#   --debug                 Enable bash execution tracing
#   --force                 Skip the confirmation prompt for destructive
#                           operations (db:push, media:push). Required for
#                           non-interactive/CI use.
#   --host <host>           Target host, from .docker/hosts.yaml
#                           Default: dev
#
#   --env <environment>     Target remote environment slug. This is the part of the
#                           remote docker-compose project directory name after
#                           "<project>_", e.g. "feature_xyz" for a directory named
#                           "myproject_feature_xyz".
#                           Default: interactively pick from the environments
#                           currently deployed on --host
#
# Configuration:
#   Built-in defaults, deep-merged with .docker/hosts.yaml (required - "app"/"hosts",
#   plus compose_projects_root if it deviates from the default), then .docker/ddep.json
#   (optional, everything else - app/hosts/compose_projects_root there are ignored, with
#   a warning) - see the schema above.
#
# Examples:
#
#   # Pull media from the test environment
#   ddep --host test --env development media:pull
#
#   # Push local media to the dev environment
#   ddep --host dev --env feature_xyz media:push
#
#   # Open an interactive shell in the dev application container
#   ddep --host dev ssh
#
#   # Execute a command inside the dev application container
#   ddep --host dev ssh "vendor/bin/typo3 list"
#
#   # Follow the dev application container's log output
#   ddep --host dev logs
#
#   # Import a database dump into the dev environment (plain SQL or gzip, both work)
#   ddep --host dev --env feature_xyz db:push < dump.sql.gz
#
#   # Export the dev database to a dump file (already gzip-compressed)
#   ddep --host dev --env feature_xyz db:pull > dump.sql.gz
#
#   # Pipe an existing dump directly into the remote database
#   cat dump.sql.gz | ddep --host dev --env feature_xyz db:push
#
#   # Export a remote TYPO3 database (plain SQL) and import it locally
#   ssh dev@vm "cd /var/www/html/typo3/current && vendor/bin/typo3 database:export" \
#       | ddep --host dev --env branch-69 db:push
#
#   # Inspect the fully resolved configuration (no git repo, host or env needed)
#   ddep config
#   ddep config | jq '.settings.symfony.rsync'
#
#   # Get the dev environment's container id (e.g. for reset-job tooling)
#   ddep --host dev --env feature_xyz info | jq -r '.container_id'

# Functions
usage() {
    cat <<'EOF'
Usage: ddep [options] <command>

Commands:
  media:push   Push local media files to the remote application container
  media:pull   Pull media files from the remote application container
  db:push      Import a database dump (stdin, plain SQL or gzip) into the remote
               DB, then migrate
  db:pull      Export the remote database to stdout, gzip-compressed
  ssh [cmd]    Open a shell, or run a command, in the remote container
  logs         Follow the remote application container's log output
  config       Print the resolved configuration as JSON
  info         Print details about the remote application container as JSON

Options:
  --host <host>   Target host from .docker/hosts.yaml (default: dev)
  --env <env>     Target environment slug (default: interactive pick)
  --force         Skip confirmation for destructive ops (db:push, media:push)
  --debug         Enable bash execution tracing
  -h, --help      Show this help and exit
  -V, --version   Show version and exit
EOF
}

check_requirements() {
    local missing=()
    local cmd
    for cmd in docker jq ssh rsync gzip git; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo "Error: required command(s) not found on PATH: ${missing[*]}" >&2
        exit 1
    fi

    if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
        echo "Error: bash >= 4.3 required, but running ${BASH_VERSION}." >&2
        echo "       On macOS: brew install bash (and put it before /bin/bash on PATH)." >&2
        exit 1
    fi
}

